# V2Auto - Subscription Sources
# =====================================================
# هر خط می‌تواند یکی از موارد زیر باشد:
#   - لینک سابسکریپشن (https://...)
#   - کانفیگ مستقیم vmess / vless / trojan / ss
#   - رشته base64 (محتوای رمزگذاری‌شده)
# خطوط شروع‌شده با # نادیده گرفته می‌شوند
# =====================================================

# ── Subscription URLs ──────────────────────────────
# https://sub.example.com/sub?token=YOUR_TOKEN_HERE
# https://raw.githubusercontent.com/user/repo/main/configs.txt

# ── VLESS (با Reality) ────────────────────────────
# vless://12345678-abcd-1234-abcd-123456789012@1.2.3.4:443?encryption=none&security=reality&type=tcp&sni=www.aparat.com&fp=chrome&pbk=PUBLIC_KEY_HERE&sid=SHORT_ID#MyServer

# ── VLESS (با TLS) ───────────────────────────────
# vless://12345678-abcd-1234-abcd-123456789012@1.2.3.4:443?encryption=none&security=tls&type=ws&path=/ws&sni=example.com#MyVless

# ── VMess ─────────────────────────────────────────
# vmess://eyJhZGQiOiIxLjIuMy40IiwicG9ydCI6NDQzLCJpZCI6InV1aWQtaGVyZSIsImFpZCI6MCwibmV0IjoidGNwIiwidHlwZSI6Im5vbmUiLCJ0bHMiOiJ0bHMiLCJwcyI6Ik15Vm1lc3MifQ==

# ── Trojan ────────────────────────────────────────
# trojan://yourpassword@1.2.3.4:443?security=tls&sni=example.com#MyTrojan

# ── Shadowsocks (SIP002 plain) ────────────────────
# ss://aes-256-gcm:your-password@1.2.3.4:8388#MySS

# ── Shadowsocks (base64 userinfo) ────────────────
# ss://YWVzLTI1Ni1nY206eW91ci1wYXNzd29yZA==@1.2.3.4:8388#MySS2
